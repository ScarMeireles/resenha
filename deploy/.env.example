# Modelo do deploy/.env. O deploy/new-env.ps1 cria o .env de verdade (segredos aleatórios e o IP do Radmin);
# ele NUNCA vai para o Git.

# IP deste PC na rede do Radmin VPN (aparece no topo da janela do Radmin).
RESENHA_HOST_IP=coloque-o-ip-do-radmin

# Chave e segredo do LiveKit (a API usa os mesmos para assinar os tokens). Segredo com 32+ caracteres.
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres

# Chave que assina o login (JWT). 32+ caracteres. Trocar desloga todo mundo.
JWT_SIGNING_KEY=troque-esta-chave-com-pelo-menos-32-caracteres
