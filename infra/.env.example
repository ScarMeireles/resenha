# Copie para infra/.env (ou rode infra/new-env.ps1, que gera tudo sozinho).
# O .env NUNCA vai para o Git.

# Chave e segredo da API do LiveKit. A API .NET usa os mesmos valores para assinar os tokens.
# O segredo precisa ter pelo menos 32 caracteres.
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres

# IP que o LiveKit anuncia para os apps se conectarem por WebRTC.
# Desenvolvimento no mesmo PC: 127.0.0.1. (O servidor real usa o deploy/, com o IP do Radmin.)
LIVEKIT_NODE_IP=127.0.0.1
