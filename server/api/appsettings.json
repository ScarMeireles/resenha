{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Root": ".data"
  },
  "Jwt": {
    "Issuer": "resenha-api",
    "Audience": "resenha-app",
    "LifetimeDays": 30
  },
  "LiveKit": {
    "Url": "ws://localhost:7880",
    "TokenMinutes": 360
  },
  "RateLimit": {
    "AuthPerMinute": 10
  }
}
