# Copie para .env só se a API não estiver no endereço padrão.
# Não é segredo, mas o .env fica fora do Git para cada um apontar para onde quiser.
VITE_API_URL=http://localhost:5280
# Servidor de mídia (LiveKit). Use o mesmo endereço de LiveKit:Url no appsettings da API.
VITE_LIVEKIT_URL=ws://localhost:7880
# Instalador para o servidor real: crie .env.production (também fora do Git) com http://IP-DO-RADMIN:8080 e
# ws://IP-DO-RADMIN:7890. Ele só vale para o npm run dist. Veja docs/HOSPEDAGEM.md.
