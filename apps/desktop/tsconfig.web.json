{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "paths": { "@shared/*": ["../../shared/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/main/screenChoice.ts", "src/main/popoutName.ts", "../../shared/*.json"]
}
